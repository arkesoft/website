# Güvenli sunucu ağacında arkesoft-private/.env; public_html dışında tutulur.
# Gerçek .env dosyası Git'e veya dağıtım ZIP'ine eklenmez.
# Boşluk veya # içeren parolaları tırnaklayın; değişken genişletme yapılmaz.
# Panelde otomatik gönderim varsayılandır; bilgiler tamamlanınca yeni talepler gönderilir.
# Ek kod değişikliği veya zorunlu zamanlanmış görev kurulumu yoktur.
BRIEF_TO=
BRIEF_FROM=
BRIEF_FROM_NAME="ARKESOFT"
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 465 için ssl; 587 için tls (STARTTLS). Her iki durumda sertifika doğrulanır.
SMTP_ENCRYPTION=ssl
# İlk adres canonical site adresidir. Diğer adresler aynı sitenin alternatifleridir.
PUBLIC_ORIGIN=https://arkesoft.com,https://www.arkesoft.com
