# Arkesoft form ayarları. Bu dosyayı ".env" adıyla kopyalayıp doldurun.
# Hostinger: .env dosyasını public_html'in BİR ÜST klasörüne koyun
#   ör. domains/arkesoft.com/.env  (public_html'in yanına, içine değil)
# .env dosyası git'e eklenmez ve yükleme zip'ine girmez.
# Şifrede boşluk veya # varsa çift tırnak içine yazın: SMTP_PASS="şifre #1"

# Formların geleceği adres
BRIEF_TO=arkesoft.info@gmail.com

# Mailin gönderileceği hesap ve görünen ad
BRIEF_FROM=info@arkesoft.com
BRIEF_FROM_NAME=Arkesoft

# Hostinger e-posta hesabı ile gönderim
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@arkesoft.com
SMTP_PASS=

# Gmail ile göndermek isterseniz yukarıdaki SMTP satırları yerine:
# BRIEF_FROM=arkesoft.info@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=arkesoft.info@gmail.com
# SMTP_PASS=google-uygulama-sifresi

# Sitenin adresleri, virgülle ayrılmış, sonda / olmadan
PUBLIC_ORIGIN=https://arkesoft.com,https://www.arkesoft.com

# Vercel veya Cloudflare Pages kullanılırsa (Resend ile gönderim):
# RESEND_API_KEY=
